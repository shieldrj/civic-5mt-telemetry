# The rescued WebView localStorage is evidence: it has to come back out of git
# byte for byte. Without this, Git's CRLF conversion rewrites bare LF bytes
# inside the leveldb files and the "byte-verified against the device" claim in
# the commit that added them stops being true on the next checkout.
migration-backup/** -text -diff

# Shell scripts must reach a Linux CI runner with LF endings and their executable bit.
# `./gradlew` with CRLF fails as "bad interpreter: /bin/sh^M", and without +x it fails as
# "Permission denied" - both only on the runner, never on the Windows machine they were
# written on.
*.sh        text eol=lf
gradlew     text eol=lf
*.bat       text eol=crlf
