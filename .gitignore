# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Capacitor: regenerated from dist/ by `npx cap sync`, so not source
android/app/src/main/assets/public
android/app/src/main/assets/capacitor.config.json
android/app/src/main/assets/capacitor.plugins.json

# The rescued leveldb write-ahead log. *.log above would otherwise drop it,
# and it is the file holding the oil-life history.
!migration-backup/**/*.log

# Native Android build: Gradle output and local machine config. Sources under app-native/
# are tracked; nothing generated is. The build itself runs from a mirror outside OneDrive
# (see app-native/build.sh), so these only appear if someone builds in place.
app-native/.gradle
app-native/build
app-native/*/build
app-native/local.properties
